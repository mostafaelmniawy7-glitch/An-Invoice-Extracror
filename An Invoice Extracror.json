    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "cachedResultName": "GPT-4O-MINI",
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "content": "# ROLE\nYou are an expert invoice data extraction specialist. You receive raw text from invoice PDFs and extract structured data.\n\n# TASK\nExtract the following fields from the invoice text and return ONLY valid JSON:\n\n{\n  \"invoice_number\": \"string or null\",\n  \"invoice_date\": \"YYYY-MM-DD or null\",\n  \"vendor_name\": \"string or null\",\n  \"customer_name\": \"string or null\",\n  \"subtotal\": number or null,\n  \"tax\": number or null,\n  \"total\": number or null,\n  \"currency\": \"EGP | USD | EUR | SAR | AED\",\n  \"items\": [\n    {\n      \"description\": \"string\",\n      \"quantity\": number,\n      \"unit_price\": number,\n      \"total\": number\n    }\n  ]\n}\n\n# EXTRACTION RULES\n1. invoice_date MUST be in YYYY-MM-DD format\n2. All amounts must be numbers (no currency symbols in the number)\n3. currency: detect from symbol or text\n4. If a field is missing, use null\n5. items array: extract every line item\n6. subtotal = total before tax\n7. total = final amount including tax\n\n# OUTPUT FORMAT\nReturn ONLY valid JSON. No markdown fences. No explanation.\n\n# EXAMPLE OUTPUT\n{\n  \"invoice_number\": \"INV-2024-1234\",\n  \"invoice_date\": \"2024-06-15\",\n  \"vendor_name\": \"شركة النور للتوريدات\",\n  \"customer_name\": \"مطعم الأصيل\",\n  \"subtotal\": 1000,\n  \"tax\": 140,\n  \"total\": 1140,\n  \"currency\": \"EGP\",\n  \"items\": [\n    {\"description\": \"أرز\", \"quantity\": 10, \"unit_price\": 50, \"total\": 500},\n    {\"description\": \"زيت\", \"quantity\": 5, \"unit_price\": 100, \"total\": 500}\n  ]\n}\n\nStart now."
            },
            {
              "content": "=Invoice text:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        128,
        -16
      ],
      "id": "c71955e4-4096-4a46-a869-010a44efd743",
      "name": "AI Extractor",
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Extract the model text from the OpenAI Responses API output (with fallbacks)\nlet aiResponse = '';\nif (Array.isArray(item.output)) {\n  for (const msg of item.output) {\n    if (Array.isArray(msg.content)) {\n      for (const c of msg.content) {\n        if (c.type === 'output_text' && c.text) aiResponse += c.text;\n      }\n    }\n  }\n} else if (item.message && item.message.content) {\n  aiResponse = item.message.content;\n} else if (typeof item.text === 'string') {\n  aiResponse = item.text;\n}\n\nlet parsed;\ntry {\n  const cleaned = aiResponse.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    invoice_number: null,\n    invoice_date: null,\n    vendor_name: null,\n    customer_name: null,\n    subtotal: null,\n    tax: null,\n    total: null,\n    currency: 'EGP',\n    items: []\n  };\n}\n\nconst rawText = $('Extract PDF Text').first().json.text || '';\nconst binary = $('Webhook').first().binary || {};\nconst fileName = Object.values(binary)[0]?.fileName || '';\n\nconst num = (v) => (v === null || v === undefined || v === '' || isNaN(Number(v))) ? null : Number(v);\n\nreturn [{\n  json: {\n    invoice_number: parsed.invoice_number ?? null,\n    invoice_date: parsed.invoice_date ?? null,\n    vendor_name: parsed.vendor_name ?? null,\n    customer_name: parsed.customer_name ?? null,\n    subtotal: num(parsed.subtotal),\n    tax: num(parsed.tax),\n    total: num(parsed.total),\n    currency: parsed.currency || 'EGP',\n    items: Array.isArray(parsed.items) ? parsed.items : [],\n    raw_text: rawText.substring(0, 3000),\n    file_name: fileName\n  }\n}];"
      },
